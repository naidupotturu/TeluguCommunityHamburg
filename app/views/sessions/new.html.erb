<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">

      <div class="card shadow">
        <div class="card-header bg-secondary-subtle text-white text-center">
          <h4 class="mb-0">Login</h4>
        </div>
        <div class="card-body">

          <%= form_with url: login_path, method: :post, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :email, class: "form-label" %>
              <%= form.email_field :email, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <%= form.label :password, class: "form-label" %>
              <%= form.password_field :password, class: "form-control", required: true %>
            </div>

            <div class="d-grid">
              <%= form.submit "Login", class: "btn btn-secondary" %>
            </div>
          <% end %>

          <div class="mt-3 text-center">
<!--            <p>Don't have an account? <%#= link_to "Sign Up", signup_path %></p>-->
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
