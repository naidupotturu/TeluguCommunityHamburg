                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

            <% (2023..2023).reverse_each do |year| %>

              <div id="year-<%= year %>" class="mb-5 p-3 border rounded bg-light shadow-sm">
                <h4 class="text-primary mb-4">Calendar - <%= year %></h4>
                <div class="row">


                  <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                      <div class="card-header bg-primary text-white">
                        March <%= year %>
                      </div>
                      <div class="card-body">
                        <%= image_tag("mar#{year}.png", class: "img-fluid mb-2", alt: "Ugadi Celebrations") %>
                        <ul class="list-unstyled">
                          <li>Ugadi Celebrations</li>
                        </ul>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                      <div class="card-header bg-warning text-dark">
                        oct <%= year %>
                      </div>
                      <div class="card-body">
                        <%= image_tag("oct#{year}.png", class: "img-fluid mb-2", alt: "Sri Srinivasa Kalyanam 2023", size: "300x300")%>
                        <ul class="list-unstyled">
                          <li><strong>📅 Oct 3:</strong> Sri Srinivasa Kalyanam</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

         <% (2020..2022).reverse_each do |year| %>

        <div id="year-<%= year %>" class="mb-5 p-3 border rounded bg-light shadow-sm">
          <h4 class="text-primary mb-4">Calendar - <%= year %></h4>
          <div class="row">

            <div class="col-md-4 mb-4">
              <div class="card h-100 shadow-sm">
                <div class="card-header bg-warning text-dark">
