<div class="container-fluid mt-4">
  <div class="row">
    <!-- Left Side Year Buttons -->
    <div class="col-md-3">
      <div class="d-flex flex-column gap-2">
        <% (2015..2025).reverse_each do |year| %>
          <button class="btn btn-secondary text-white w-100"
                  onclick="document.getElementById('year-<%= year %>').scrollIntoView({ behavior: 'smooth' });">
            <%= year %>
          </button>
        <% end %>
      </div>
    </div>

    <!-- Right Side Calendar -->
    <div class="col-md-9" style="height: 600px; overflow-y: auto;">
      <% (2015..2025).reverse_each do |year| %>
        <div id="year-<%= year %>" class="mb-5 p-3 border rounded bg-light shadow-sm">
          <h4 class="text-primary mb-4">Calendar - <%= year %></h4>
          <div class="row">

            <!-- Sankranti - January -->
            <div class="col-md-4 mb-4">
              <div class="card h-100 shadow-sm">
                <div class="card-header bg-primary text-white">
                  January <%= year %>
                </div>
                <div class="card-body">
                  <%#= image_tag("sankranti.jpg", class: "img-fluid mb-2", alt: "Sankranti") %>
                  <ul class="list-unstyled">
                    <li><strong>📅 Jan 14:</strong> Sankranti Sambaralu</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Ugadi - March -->
            <div class="col-md-4 mb-4">
              <div class="card h-100 shadow-sm">
                <div class="card-header bg-success text-white">
                  March <%= year %>
                </div>
                <div class="card-body">
                  <%#= image_tag("ugadi.jpg", class: "img-fluid mb-2", alt: "Ugadi") %>
                  <ul class="list-unstyled">
                    <li><strong>📅 Mar 30:</strong> Ugadi Celebration</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Diwali - November -->
            <div class="col-md-4 mb-4">
              <div class="card h-100 shadow-sm">
                <div class="card-header bg-warning text-dark">
                  November <%= year %>
                </div>
                <div class="card-body">
                  <%#= image_tag("diwali.jpg", class: "img-fluid mb-2", alt: "Diwali") %>
                  <ul class="list-unstyled">
                    <li><strong>📅 Nov 10:</strong> Diwali Celebrations</li>
                  </ul>
                </div>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
