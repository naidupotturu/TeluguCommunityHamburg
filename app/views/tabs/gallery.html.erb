<div class="container mt-5">
  <div class="text-center mb-4">
    <h2 class="fw-bold text-primary">📸 Event Gallery</h2>
    <p class="text-muted">A glimpse into our cultural celebrations and community moments.</p>
  </div>

  <div class="row">
    <% @images = ["ttd.jpeg", "img4.png", "img1.png", "img2.png","img3.png"] %>
    <% @images.each do |img| %>
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm">
          <%= image_tag img, class: "card-img-top img-fluid object-fit-cover", alt: "Event Photo", style: "height: 400px;" %>
          <div class="card-body text-center">
            <p class="card-text text-muted">Srinivasa Abhisekam & Kukumarchana</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-5">
    <h2 class="fw-bold text-primary text-center mb-4">🎥 Event Videos</h2>
    <div class="row g-4">
      <% ["slide_vedio4.mp4", "slide-vedio3.mp4", "slide_vedio2.mp4", "slide6.mp4"].each do |video| %>
        <div class="col-md-6">
          <div style="height: 500px; overflow: hidden;">
            <%= video_tag video, autoplay: true, loop: true, muted: true, playsinline: true, class: "w-100 h-100", style: "object-fit: cover;" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
