<div class="container my-5">
  <h2 class="text-center text-primary-emphasis mb-4"> Event History</h2>

  <div class="row">
    <!-- Event 1 -->
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm">
        <%= image_tag("Mar2025.jpeg", class: "card-img-top", alt: "Ugadi Celebration") %>
        <div class="card-body">
          <h5 class="card-title">TTD Samprokshana Abhishekam 2024 </h5>
          <p class="card-text">Join us for cultural performances, food, and festivities to celebrate Telugu New Year.</p>
        </div>
        <div class="card-footer text-muted">
          📅 March 30, 2025 | 📍 Bürgerhaus Hamburg
        </div>
      </div>
    </div>

    <!-- Event 2 -->
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm">
        <%= image_tag("TTD2024.jpeg", class: "card-img-top", alt: "Srinivasa Kalyanam") %>
        <div class="card-body">
          <h5 class="card-title">Sri Srinivasa Kalyanam</h5>
          <p class="card-text">A spiritual wedding celebration of Lord Venkateswara organized with devotion and traditional rituals.</p>
        </div>
        <div class="card-footer text-muted">
          📅 Nov 23, 2024 | 📍 Sri Venkateswara Temple, Hamburg
        </div>
      </div>
    </div>

    <!-- Event 3 -->
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm">
        <%= image_tag("Seeta.jpg", class: "card-img-top", alt: "Diwali Event") %>
        <div class="card-body">
          <h5 class="card-title">Sri Seetha Rama Kalyanam </h5>
          <p class="card-text">An evening of lights, dance, music, and joy for the Telugu community in Hamburg.</p>
        </div>
        <div class="card-footer text-muted">
          📅 Apr 28, 2024 | 📍 Buchholz
        </div>
      </div>
    </div>
  </div>
</div>
