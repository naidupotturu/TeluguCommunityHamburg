<div class="container mt-4">
  <div id="mainCarousel" class="carousel slide mb-5" data-ride="carousel" data-interval="2000">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <%= image_tag 'slide1.jpg', class: "d-block w-100", alt: "Banner 1" %>
      </div>
      <div class="carousel-item">
        <%= image_tag 'slide2.jpg', class: "d-block w-100", alt: "Banner 2" %>
      </div>
      <div class="carousel-item">
        <%= image_tag 'slide3.jpg', class: "d-block w-100", alt: "Banner 3" %>
      </div>
      <div class="carousel-item">
        <%= image_tag 'slide4.png', class: "d-block w-100", alt: "Banner 4" %>
      </div>
    </div>
    <a class="carousel-control-prev" href="#mainCarousel" role="button" data-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </a>
    <a class="carousel-control-next" href="#mainCarousel" role="button" data-slide="next">
      <span class="carousel-control-next-icon"></span>
    </a>
  </div>
</div>



