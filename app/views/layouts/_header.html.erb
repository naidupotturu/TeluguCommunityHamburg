<div class="container-fluid py-3 bg-white border-bottom">
  <div class="container">
    <div class="row align-items-center">

      <!-- Left Section: Logo and Title -->
      <div class="col-md-6 d-flex align-items-center">
        <%= image_tag("telugualogo.png", alt: "Telugu Community Hamburg Logo", size: "150x150", class: "me-3") %>
        <div>
          <h4 class="mb-0 fw-bold">TELUGU COMMUNITY HAMBURG e.V., Germany</h4>
          <h6 class="text-primary" style="font-family: 'Noto Sans Telugu', sans-serif;">
            తెలుగు కమ్యూనిటీ హాంబర్గ్ ఈ.వి. జర్మనీ
          </h6>
        </div>
      </div>

      <!-- Right Section: Namalu and TTD Images -->
      <div class="col-md-6 d-flex justify-content-end align-items-center">
        <div class="text-center me-4">
          <%= image_tag("ttd.jpeg", alt: "Om Namo Venkatesaya", size: "120x120", class: "mb-1") %>
          <div><small>Om Namo Venkatesaya ఓం నమో వేంకటేశాయ</small> </div>
        </div>
      </div>
    </div>
  </div>
</div>

